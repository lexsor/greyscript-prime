  "_comment_random_from": "======================== random_from ========================",
  "random_from (define)": {
    "prefix": "random_from",
    "body": [
      "random_from = function(min = 0)",
      "\tlocals.max = self",
      "\treturn floor((rnd * (locals.max - locals.min + 1)) + locals.min)  ",
      "end function"
    ],
    "description": "Define random_from(min = 0)"
  },
  "_comment_lerp": "======================== lerp ========================",
  "lerp (define)": {
    "prefix": "lerp",
    "body": [
      "lerp = function(min, max, offset)",
      "\tif locals.offset > 1 then locals.offset = 1",
      "\tif locals.offset < 0 then locals.offset = 0",
      "\tlocals.difference = locals.max - locals.min",
      "\tlocals.scaled_difference = locals.offset * locals.difference",
      "\t\treturn locals.min + locals.scaled_difference",
      "end function"
    ],
    "description": "Define lerp(min, max, offset)"
  }
}