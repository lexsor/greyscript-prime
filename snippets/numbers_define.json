  "_comment_clamp": "======================== clamp ========================",
  "clamp (define)": {
    "prefix": "clamp",
    "body": [
      "clamp = function(min, max)",
      "\tif self < locals.min then return locals.min",
      "\tif self > locals.max then return locals.max",
      "\t\treturn self",
      "end function"
    ],
    "description": "Define clamp(min, max)"
  },
  "_comment_diff": "======================== diff ========================",
  "diff (define)": {
    "prefix": "diff",
    "body": [
      "diff = function(distanceTo = 0)",
      "\treturn abs(self - locals.distanceTo)",
      "end function"
    ],
    "description": "Define diff(distanceTo = 0)"
  },
  "_comment_div": "======================== div ========================",
  "div (define)": {
    "prefix": "div",
    "body": [
      "div = function(amount = 2)",
      "\tif typeof(locals.amount) == \"number\" then",
      "\t\tif locals.amount == 0 then return 0",
      "\tend if",
      "\t\treturn self / locals.amount",
      "end function"
    ],
    "description": "Define div(amount = 2)"
  },
  "_comment_is_float": "======================== is_float ========================",
  "is_float (define)": {
    "prefix": "is_float",
    "body": [
      "is_float = function()",
      "\tif str(self).indexOf(\".\") > 0 then return true",
      "\t\treturn false",
      "end function"
    ],
    "description": "Define is_float()"
  },
  "_comment_is_integer": "======================== is_integer ========================",
  "is_integer (define)": {
    "prefix": "is_integer",
    "body": [
      "is_integer = function()",
      "\tif not self == round(self) then return false",
      "\t\treturn true",
      "end function"
    ],
    "description": "Define is_integer()"
  },
