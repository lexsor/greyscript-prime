    "prefix": "list.crop",
    "body": [
      "list.crop = function()",
      "        while not self[self.len - 1].len > 0",
      "            self.remove(self.len - 1)",
      "        end while",
      "        while not self[0].len > 0",
      "            self.remove(0)",
      "        end while",
      "        return self",
      "    end function"
    ],
    "description": "Define list.crop()"
  },
