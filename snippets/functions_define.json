  "_comment_load_lib": "======================== load_lib ========================",
  "load_lib (define)": {
    "prefix": "load_lib",
    "body": [
      "load_lib = function(libName = \"metaxploit.so\", libDir = \"/lib\", libType = \"\")",
      "\tlocals.libLocation = locals.libDir + \"/\" + locals.libName",
      "\tif locals.libName == \"\" then",
      "\t\treturn null",
      "\tend if",
      "\tlocals.lib = include_lib(locals.libLocation)",
      "\tif not typeof(locals.lib) == null then",
      "\t\tif locals.libType == \"\" then",
      "\t\t\treturn locals.lib",
      "\t\tif typeof(locals.lib) == locals.libType then",
      "\t\t\treturn locals.lib",
      "\t\telse",
      "\t\t\treturn null",
      "\t\tend if",
      "\telse",
      "\t\treturn null",
      "\tend if",
      "end function",
      "",
      ""
    ],
    "description": "Define load_lib(libName = \"metaxploit.so\", libDir = \"/lib\", libType = \"\")"
  },
  "_comment_network_device_list": "======================== network_device_list ========================",
  "network_device_list (define)": {
    "prefix": "network_device_list",
    "body": [
      "network_device_list = function(user = \"\", pass = \"\")",
      "\tlocals.networkDevices = split(get_shell(locals.user, locals.pass).host_computer.network_devices, char(10))",
      "\tlocals.networkDeviceList = []",
      "\tfor device in locals.networkDevices",
      "\t\tif locals.device then locals.networkDeviceList.push(split(locals.device, \" \"))",
      "\tend for",
      "\treturn locals.networkDeviceList",
      "end function"
    ],
    "description": "Define network_device_list(user = \"\", pass = \"\")"
  },
  "_comment_parse_inbox": "======================== parse_inbox ========================",
  "parse_inbox (define)": {
    "prefix": "parse_inbox",
    "body": [
      "parse_inbox = function(mailIDList)",
      "\tlocals.mailObjects = []",
      "\tlocals.bodyText = \"\"",
      "\tfor mailList in locals.mailIDList",
      "\t\tlocals.mail = new{\"id\":\"\", \"from\":\"\", \"subject\":\"\", \"summary\":\"\", \"body\":\"\"}",
      "\t\tlocals.rawMail = globals.metaMail.read(locals.mailList)",
      "\t\tlocals.segments = (locals.rawMail.split(char(10))).crop",
      "\t\tlocals.mail.from = locals.segments[0][6:]",
      "\t\tlocals.mail.subject = locals.segments[1][9:]",
      "\t\tlocals.segments.remove(0) // remove from",
      "\t\tlocals.segments.remove(0) // remove subject",
      "\t\tlocals.mail.id = locals.mailList",
      "\t\tlocals.mail.body = locals.segments.string ",
      "\t\tlocals.mailObjects.push(locals.mail)",
      "\tend for",
      "\t\treturn locals.mailObjects",
      "end function"
    ],
    "description": "Define parse_inbox(mailIDList)"
  },
