{
  "_comment_file_new": "======================== file_new ========================",
  "file_new (define)": {
    "prefix": "file_new",
    "body": [
      "file_new = function(filePath, fileName)",
      "\tlocals.hostComputer = get_shell.host_computer",
      "\tlocals.fileLocation = locals.filePath + \"/\" + locals.fileName",
      "\tlocals.fileObj = locals.hostComputer.File(locals.fileLocation)",
      "\tif not locals.fileObj then",
      "\t\tlocals.hostComputer.touch(locals.filePath, locals.fileName)",
      "\t\tlocals.fileObj = locals.hostComputer.File(locals.fileLocation)",
      "\tend if",
      "\tif locals.fileObj then",
      "\t\treturn true",
      "\telse",
      "\t\treturn false",
      "\tend if",
      "end function"
    ],
    "description": "Define file_new(filePath, fileName)"
  },
  "_comment_force_params": "======================== force_params ========================",
  "force_params (define)": {
    "prefix": "force_params",
    "body": [
      "force_params = function(usage, minReqParams)",
      "\tif globals.params.len < 1 then exit locals.usage",
      "\tif globals.params[0] == \"-h\" or globals.params[0] == \"--help\" then exit locals.usage",
      "\tif globals.params.len < locals.minReqParams then exit locals.usage",
      "end function"
    ],
    "description": "Define force_params(usage, minReqParams)"
  },
  "_comment_get_acks": "======================== get_acks ========================",
  "get_acks (define)": {
    "prefix": "get_acks",
    "body": [
      "get_acks = function(signalStrength = 1)",
      "\tif not typeof(locals.signalStrength) == \"number\" then",
      "\t\tlocals.removePercent = locals.signalStrength.remove(\"%\") //check for % in number string",
      "\t\tlocals.newNumber = typeof(to_int(locals.removePercent))",
      "\t\tif not locals.newNumber == \"number\" then return null",
      "\t\tif locals.newNumber < 0 then return null",
      "\t\tif locals.newNumber > 100 then return null",
      "\t\tlocals.signalStrength = locals.newNumber",
      "\tend if",
      "\tif locals.signalStrength <= 0 or locals.signalStrength > 100 then return null",
      "\treturn ceil(300000 / (locals.signalStrength + 15))",
      "end function"
    ],
    "description": "Define get_acks(signalStrength = 1)"
  },
  "_comment_get_exploit_address_list": "======================== get_exploit_address_list ========================",
  "get_exploit_address_list (define)": {
    "prefix": "get_exploit_address_list",
    "body": [
      "get_exploit_address_list = function(libLocation, metaxploitObject, remoteTarget = false, targetPort = 0)",
      "\tlocals.metax = locals.metaxploitObject",
      "\tif locals.remoteTarget == false then",
      "\t\tlocals.metaLib = locals.metax.load(locals.libLocation)",
      "\telse",
      "\t\tlocals.netSession = locals.metax.net_use(locals.libLocation, locals.targetPort)",
      "\t\tlocals.metaLib = locals.netSession.dump_lib",
      "\tend if",
      "\tlocals.libScanResult = locals.metax.scan(locals.metaLib)",
      "\treturn locals.libScanResult",
      "end function"
    ],
    "description": "Define get_exploit_address_list(libLocation, metaxploitObject, remoteTarget = false, targetPort = 0)"
  },
  "_comment_bool_text": "======================== bool_text ========================",
  "bool_text (define)": {
    "prefix": "bool_text",
    "body": [
      "bool_text = function(boolVal, text = [\"true\", \"false\"])",
      "\tlocals.boolText = {\"yes\":\"false\", \"no\":\"false\"}",
      "\tif locals.boolVal < 0 then return locals.boolText.no",
      "\tif locals.boolVal > 1 then return locals.boolText.yes",
      "\tif locals.boolVal == 1 then return locals.boolText.yes",
      "\tif locals.boolVal == 0 then return locals.boolText.no",
      "\treturn null",
      "end function"
    ],
    "description": "Define bool_text(boolVal, text = [\"true\", \"false\"])"
  },
  "_comment_display_menu": "======================== display_menu ========================",
  "display_menu (define)": {
    "prefix": "display_menu",
    "body": [
      "display_menu = function(menuList, selectedItem, highlightcolor = \"#FFFF002C\", textColor = null)",
      "\tlocals.outputMenu = []",
      "\tfor menuItem in locals.menuList",
      "\t\tif locals.selectedItem == __menuItem_idx then",
      "\t\tif locals.textColor == null then",
      "\t\tlocals.outputMenu.push(locals.menuItem.mark(locals.highlightcolor))",
      "\t\telse",
      "\t\tlocals.outputMenu.push(locals.menuItem.color(locals.textColor).mark(locals.highlightcolor))",
      "\t\tend if",
      "\t\telse",
      "\t\tlocals.outputMenu.push(locals.menuItem)",
      "\t\tend if",
      "\tend for",
      "\treturn locals.outputMenu",
      "end function"
    ],
    "description": "Define display_menu(menuList, selectedItem, highlightcolor = \"#FFFF002C\", textColor = null)"
  },
  "_comment_user_navigation": "======================== user_navigation ========================",
  "user_navigation (define)": {
    "prefix": "user_navigation",
    "body": [
      "user_navigation = function (numberIndex, userInput)",
      "\tindexChange = numberIndex",
      "\tif locals.userInput == \"UpArrow\" then",
      "\t\tlocals.indexChange = locals.indexChange - 1",
      "\tend if",
      "\tif locals.userInput == \"DownArrow\" then",
      "\t\tlocals.indexChange = locals.indexChange + 1",
      "\tend if",
      "\treturn locals.indexChange",
      "end function"
    ],
    "description": "Define user_navigation(numberIndex, userInput)"
  },
  "_comment_extractIP": "======================== extractIP ========================",
  "extractIP (define)": {
    "prefix": "extractIP",
    "body": [
      "extractIP = function(inputString)",
      "\tlocals.ipPattern = \"\\b(?:(?:25[0-5]|2[0-4]\\\\d|1\\\\d\\\\d|[1-9]?\\\\d)\\\\.){3}(?:25[0-5]|2[0-4]\\\\d|1\\\\d\\\\d|[1-9]?\\\\d)\\b\"",
      "\tlocals.matchResult = inputString.matches(locals.ipPattern)",
      "\tif locals.matchResult.values.len > 0 then",
      "\t\treturn locals.matchResult.values[0]",
      "\telse",
      "\t\treturn null",
      "\tend if",
      "end function"
    ],
    "description": "Define extractIP(inputString)"
  },
  "_comment_file_append": "======================== file_append ========================",
  "file_append (define)": {
    "prefix": "file_append",
    "body": [
      "file_append = function(savePath, saveFile, newText)",
      "\t//********************************************",
      "\tlocals.fileContent = \"\"",
      "\tlocals.fileLocation = locals.savePath + \"/\" + locals.saveFile",
      "\t//********************************************\t",
      "\tlocals.hostComputer = get_shell.host_computer",
      "\tlocals.fileObj = locals.hostComputer.File(locals.fileLocation)",
      "\tif not locals.fileObj then",
      "\t\tlocals.hostComputer.touch(locals.savePath, locals.saveFile)",
      "\t\tlocals.fileObj = locals.hostComputer.File(locals.fileLocation)",
      "\tend if",
      "\t//********************************************",
      "\t//********************************************\t\t",
      "\tif locals.fileObj.has_permission(\"r\") then",
      "\t\tif locals.fileObj.has_permission(\"w\") then",
      "\t\t\tlocals.fileContent = locals.fileObj.get_content",
      "\t\t\tif locals.fileContent == null then",
      "\t\t\t\tlocals.fileObj.set_content(locals.newText)",
      "\t\t\telse",
      "\t\t\t\tlocals.fileObj.set_content(locals.fileContent + locals.newText)",
      "\t\t\tend if",
      "\t\telse",
      "\t\tprint(\"Permission Error Saving Data to: \" + locals.saveFile + \" [No Write Permission]\")",
      "\t\tend if",
      "\telse",
      "\t\tprint(\"Permission Error Saving Data to: \" + locals.saveFile + \" [No Read Permission]\")",
      "\tend if",
      "end function"
    ],
    "description": "Define file_append(savePath, saveFile, newText)"
  },
