  "_comment_get_overflow_owner": "======================== get_overflow_owner ========================",
  "get_overflow_owner (define)": {
    "prefix": "get_overflow_owner",
    "body": [
      "get_overflow_owner = function(overflowObject)",
      "\tlocals.overflowOwner = null",
      "\tlocals.overflowObjectType = typeof(locals.overflowObject)",
      "\tif locals.overflowObjectType == \"file\" then",
      "\t\treturn locals.overflowObject.owner",
      "\tend if",
      "\tif locals.overflowObjectType == \"shell\" or locals.overflowObjectType == \"computer\" then",
      "\t\tif locals.overflowObjectType == \"shell\" then locals.rootFolder = locals.overflowObject.host_computer.File(\"/root\")",
      "\t\tif overflowObjectType == \"computer\" then locals.rootFolder = locals.overflowObject.File(\"/root\")",
      "\t\tif not locals.rootFolder.has_permission(\"w\") == 0 then return \"root\"",
      "\t\tif locals.overflowObjectType == \"shell\" then locals.homeFolders = locals.overflowObject.host_computer.File(\"/home\").get_folders",
      "\t\tif locals.overflowObjectType == \"computer\" then locals.homeFolders = locals.overflowObject.File(\"/home\").get_folders",
      "\t\tfor userFolder in locals.homeFolders",
      "\t\t\tif locals.userFolder.has_permission(\"w\") then",
      "\t\t\tlocals.overflowOwner = locals.userFolder.name",
      "\t\t\tif not locals.overflowOwner == \"guest\" then return locals.userFolder.name",
      "\t\t\tend if",
      "\t\tend for",
      "\tend if",
      "\treturn locals.overflowOwner           ",
      "end function"
    ],
    "description": "Define get_overflow_owner(overflowObject)"
  },
  "_comment_get_random_ip": "======================== get_random_ip ========================",
  "get_random_ip (define)": {
    "prefix": "get_random_ip",
    "body": [
      "get_random_ip = function()",
      "locals.generateRandomOctet = function()",
      "locals.binaryString = \"\"",
      "for i in range(8, 1)",
      "\t// Convert the random float to a binary digit using a threshold:",
      "\tif rnd() >= 0.5 then",
      "\tlocals.binaryString = locals.binaryString + \"1\"",
      "\telse",
      "\tlocals.binaryString = locals.binaryString + \"0\"",
      "\tend if",
      "end for",
      "return (0 + to_int(locals.binaryString[0])) * 128 +",
      "(0 + to_int(locals.binaryString[1])) * 64 +",
      "(0 + to_int(locals.binaryString[2])) * 32 +",
      "(0 + to_int(locals.binaryString[3])) * 16 +",
      "(0 + to_int(locals.binaryString[4])) * 8 +",
      "(0 + to_int(locals.binaryString[5])) * 4 +",
      "(0 + to_int(locals.binaryString[6])) * 2 +",
      "(0 + to_int(locals.binaryString[7]))",
      "end function"
    ],
    "description": "Define get_random_ip()"
  },
  "_comment_get_subnet_non_routers": "======================== get_subnet_non_routers ========================",
  "get_subnet_non_routers (define)": {
    "prefix": "get_subnet_non_routers",
    "body": [
      "get_subnet_non_routers = function(address, returnNonRouters = true, returnRouters = false)",
      "locals.target_router = get_router(locals.address)",
      "if locals.target_router == null then",
      "\treturn \"router not found.\" ",
      "end if",
      "",
      "locals.devices = devices_lan_ip(locals.target_router)",
      "locals.subnet = []",
      "",
      "for ip in locals.devices",
      "\tif locals.returnNonRouters == true then",
      "\t\tif get_router(locals.ip) == null then",
      "\t\t\tsubnet.push(locals.ip)",
      "\t\tend if",
      "\tend if",
      "\tif locals.returnRouters == true then",
      "\t\tif typeof(get_router(locals.ip)) == \"router\" then",
      "\t\t\tsubnet.push(locals.ip)",
      "\t\tend if",
      "\tend if    ",
      "end for",
      "\treturn locals.subnet",
      "end function"
    ],
    "description": "Define get_subnet_non_routers(address, returnNonRouters = true, returnRouters = false)"
  },
