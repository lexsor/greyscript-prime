  "_comment_cspace": "======================== cspace ========================",
  "cspace (define)": {
    "prefix": "cspace",
    "body": [
      "cspace = function(charSpacing = \"1em\", closeTag = true)",
      "\tif locals.closeTag == true then",
      "\t\treturn \"<cspace=\" + locals.charSpacing + \">\" + self + \"</cspace>\"",
      "\tend if",
      "\tif locals.closeTag == false then",
      "\t\treturn \"<cspace=\" + locals.charSpacing + \">\" + self",
      "\tend if",
      "end function"
    ],
    "description": "Define cspace(charSpacing = \"1em\", closeTag = true)"
  },
  "_comment_indent": "======================== indent ========================",
  "indent (define)": {
    "prefix": "indent",
    "body": [
      "indent = function(indentPercent=\"15%\", closeTag = true)",
      "\tif locals.closeTag == false then",
      "\t\treturn \"<indent=\" + locals.indentPercent + \">\" + self",
      "\telse",
      "\t\treturn \"<indent=\" + locals.indentPercent + \">\" + self + \"</indent>\"",
      "\tend if",
      "\treturn null",
      "end function"
    ],
    "description": "Define indent(indentPercent=\"15%\", closeTag = true)"
  },
  "_comment_extract": "======================== extract ========================",
  "extract (define)": {
    "prefix": "extract",
    "body": [
      "extract = function(self, tagStart = \"<b>\", tagEnd = \"</b>\")",
      "\tlocals.startIndex = self.indexOf(tagStart) + tagStart.len",
      "\tlocals.endIndex = self.indexOf(tagEnd)",
      "\treturn slice(self, locals.startIndex, locals.endIndex)",
      "end function"
    ],
    "description": "Define extract(self): substring between tagStart and tagEnd (defaults to <b>\u2026</b>)"
  },
  "_comment_format": "======================== format ========================",
  "format (define)": {
    "prefix": "format",
    "body": [
      "format = function(self, args, delim = \"%s\")",
      "\tlocals.splitStr = self.split(locals.delim)",
      "\tlocals.recompStr = \"\"",
      "\tfor i in range(0, locals.args.len()-1)",
      "\t\tlocals.recompStr = locals.recompStr + locals.splitStr[locals.i] + locals.args[locals.i]",
      "\tend for",
      "\tlocals.recompStr = locals.recompStr + locals.splitStr[locals.splitStr.len()-1]",
      "\t\treturn locals.recompStr",
      "end function"
    ],
    "description": "Define format(self, args, delim=\"%s\"): recomposes template using %s placeholders"
  },
  "_comment_mask": "======================== mask ========================",
  "mask (define)": {
    "prefix": "mask",
    "body": [
      "mask = function(self, maskString = true, maskChar = char(42), maskColor = null)",
      "\tif locals.maskColor != null then",
      "\t\tlocals.maskChar = \"<\" + locals.maskColor + \">\" + locals.maskChar + \"</color>\"",
      "\tend if",
      "\tlocals.ipPattern = \"\\b(?:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\b\"",
      "\tlocals.matchList = self.matches(locals.ipPattern)",
      "\tlocals.newString = \"\"",
      "\tif locals.maskString == false then return self",
      "\tif locals.matchList.len > 0 then",
      "\t\tlocals.newString = self",
      "\t\tfor match in locals.matchList",
      "\t\t\tlocals.newString = locals.newreplace(locals.match.value, locals.maskChar * locals.match.value.len)",
      "\t\tend for",
      "\t\treturn locals.newString",
      "\telse",
      "\t\treturn self",
      "\tend if",
      "end function"
    ],
    "description": "Define mask(self, maskString=true, maskChar='*', maskColor=null): masks IPs in the string"
  },
