  },
  "_comment_extract": "======================== string.extract ========================",
  "string.extract (define)": {
    "prefix": "string.extract",
    "body": [
      "string.extract = function(self, tagStart = \"<b>\", tagEnd = \"</b>\")",
      "    locals.startIndex = self.indexOf(tagStart) + tagStart.len",
      "    locals.endIndex = self.indexOf(tagEnd)",
      "    return slice(self, locals.startIndex, locals.endIndex)",
      "end function"
    ],
    "description": "Define string.extract(self): substring between tagStart and tagEnd (defaults to <b>\u2026</b>)"
  },
  "_comment_format": "======================== string.format ========================",
  "string.format (define)": {
    "prefix": "string.format",
    "body": [
      "string.format = function(self, args, delim = \"%s\")",
      "    locals.splitStr = self.split(locals.delim)",
      "    locals.recompStr = \"\"",
      "    for i in range(0, locals.args.len()-1)",
      "        locals.recompStr = locals.recompStr + locals.splitStr[locals.i] + locals.args[locals.i]",
      "    end for",
      "    locals.recompStr = locals.recompStr + locals.splitStr[locals.splitStr.len()-1]",
      "    return locals.recompStr",
      "end function"
    ],
    "description": "Define string.format(self, args, delim=\"%s\"): recomposes template using %s placeholders"
  },
  "_comment_mask": "======================== string.mask ========================",
  "string.mask (define)": {
    "prefix": "string.mask",
    "body": [
      "string.mask = function(self, maskString = true, maskChar = char(42), maskColor = null)",
      "    if locals.maskColor != null then",
      "        locals.maskChar = \"<\" + locals.maskColor + \">\" + locals.maskChar + \"</color>\"",
      "    end if",
      "    locals.ipPattern = \"\\b(?:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\b\"",
      "    locals.matchList = self.matches(locals.ipPattern)",
      "    locals.newString = \"\"",
      "    if locals.maskString == false then return self",
      "    if locals.matchList.len > 0 then",
      "        locals.newString = self",
      "        for match in locals.matchList",
      "            locals.newString = locals.newString.replace(locals.match.value, locals.maskChar * locals.match.value.len)",
      "        end for",
      "        return locals.newString",
      "    else",
      "        return self",
      "    end if",
      "end function"
    ],
    "description": "Define string.mask(self, maskString=true, maskChar='*', maskColor=null): masks IPs in the string"
  },
